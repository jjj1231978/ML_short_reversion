# Data
data/raw/
logs/
*.parquet
*.csv
*.h5

# data/processed is excluded wholesale, then the specific viewer artifacts the
# Hugging Face Space needs are whitelisted back in (shipped via Git LFS).
# Deliberately NOT whitelisted:
#   models/         1.3 GB of retrain bundles — predict.py needs them, the viewer does not
#   archive_*/      point-in-time result snapshots, ~1.9 GB total
#   predictions_per_model.parquet   18 MB, no page reads it
#   *_mlp.*         the MLP member was dropped from the ensemble
# Order matters: these negations MUST follow the *.parquet / *.csv rules above,
# because the last matching pattern wins.
data/processed/*
!data/processed/alpha_decay.parquet
!data/processed/baseline_r1w_returns.parquet
!data/processed/feature_importance.parquet
!data/processed/feature_importance_lightgbm.parquet
!data/processed/feature_importance_random_forest.parquet
!data/processed/metrics_summary.json
!data/processed/model_comparison.json
!data/processed/portfolio_returns.parquet
!data/processed/predictions.parquet
!data/processed/prediction_return_calibration.parquet
!data/processed/shap_features.parquet
!data/processed/shap_values.parquet
!data/processed/shap_values_lightgbm.parquet
!data/processed/shap_values_random_forest.parquet
!data/processed/weekday_effect.parquet
# Per-signal-day track record. Easy to miss when auditing which artifacts the
# app reads: page 09 builds this filename with an f-string
# (forecast_track_record_{code}.parquet), so it does not show up in a grep for
# literal artifact names. Omitting it renders the Track record page empty.
!data/processed/forecast_track_record_WED.parquet
!data/processed/forecast_track_record_THU.parquet
!data/processed/forecast_track_record_FRI.parquet
!data/processed/forecast_picks.db
!data/processed/live_trackrecord.db
!data/processed/forecasts/
!data/processed/forecasts/**
!data/processed/reports/
!data/processed/reports/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key

# Order/position artifacts — these contain the live trading book and must never
# reach the HF Space or any published surface.
data/processed/orders_*.csv
data/processed/paper_positions_*.csv
